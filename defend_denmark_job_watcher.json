    {
      "parameters": {
        "jsCode": "const denmarkHtml = ($('Fetch Denmark').first().json.data) || '';\nconst icelandHtml = ($('Fetch Iceland').first().json.data) || '';\nconst decode = (s) => String(s)\n  .replace(/&#x([0-9a-fA-F]+);/g, (_, h) => String.fromCodePoint(parseInt(h, 16)))\n  .replace(/&#(\\d+);/g, (_, d) => String.fromCodePoint(parseInt(d, 10)))\n  .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&apos;/g, \"'\")\n  .replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim();\nconst parsePrograms = (html, country) => {\n  const results = [];\n  const re = /\\/program\\/view\\/([0-9a-f-]{36})/g;\n  const positions = []; let m;\n  while ((m = re.exec(html)) !== null) positions.push({ id: m[1], idx: m.index });\n  const seen = new Set(); let prevStart = 0;\n  for (const pos of positions) {\n    if (seen.has(pos.id)) { prevStart = pos.idx; continue; }\n    seen.add(pos.id);\n    const chunk = html.slice(prevStart, pos.idx);\n    const names = [...chunk.matchAll(/underline-on-hover[^>]*>([^<]+)<\\/h5>/g)];\n    const name = names.length ? decode(names[names.length - 1][1]) : '';\n    const pays = [...chunk.matchAll(/([\\d.]+\\s*-\\s*[\\d.]+\\s*DKK)/g)];\n    const payout = pays.length ? pays[pays.length - 1][1].replace(/\\s+/g, ' ').trim() : '';\n    results.push({ id: pos.id, name, country, payout, url: 'https://platform.defenddenmark.dk/program/view/' + pos.id });\n    prevStart = pos.idx;\n  }\n  return results;\n};\nconst loggedOut = /login\\.microsoftonline\\.com/i.test(denmarkHtml)\n  || /\\/authentication\\/login/i.test(denmarkHtml)\n  || !/Denmark\\s*\\(\\s*\\d+\\s*\\)/i.test(denmarkHtml);\nconst stateRows = $('Get State').all();\nconst state = stateRows.length ? stateRows[0].json : {};\nconst prevAlerted = state.session_alerted === true || state.session_alerted === 'true';\nconst prevDenmark = Number(state.denmark_count || 0);\nconst prevIceland = Number(state.iceland_count || 0);\nconst out = [];\nif (loggedOut) {\n  if (!prevAlerted) out.push({ json: { action: 'session_expired' } });\n  out.push({ json: { action: 'update_state', singleton: 'state', denmark_count: prevDenmark, iceland_count: prevIceland, session_alerted: true } });\n  return out;\n}\nconst programs = [...parsePrograms(denmarkHtml, 'Denmark'), ...parsePrograms(icelandHtml, 'Iceland')];\nconst dCount = Number((denmarkHtml.match(/Denmark\\s*\\(\\s*(\\d+)\\s*\\)/i) || [])[1] || 0) || prevDenmark;\nconst iCount = Number((denmarkHtml.match(/Iceland\\s*\\(\\s*(\\d+)\\s*\\)/i) || [])[1] || 0) || prevIceland;\nconst known = new Set($('Get Known Programs').all().map(r => String(r.json.program_id)).filter(Boolean));\nconst fresh = programs.filter(p => p.id && !known.has(p.id));\nfor (const p of fresh) {\n  out.push({ json: { action: 'new_program', program_id: p.id, name: p.name || '(name unavailable)', country: p.country, payout: p.payout || 'N/A', url: p.url } });\n}\nconst freshIceland = fresh.filter(p => p.country === 'Iceland').length;\nif (prevIceland > 0 && (iCount - prevIceland) > freshIceland) {\n  out.push({ json: { action: 'new_unnamed', country: 'Iceland', prev_count: prevIceland, new_count: iCount, delta: (iCount - prevIceland) - freshIceland, url: 'https://platform.defenddenmark.dk/program/bug-bounty/?tab=iceland' } });\n}\nconst freshDenmark = fresh.filter(p => p.country === 'Denmark').length;\nif (prevDenmark > 0 && (dCount - prevDenmark) > freshDenmark) {\n  out.push({ json: { action: 'new_unnamed', country: 'Denmark', prev_count: prevDenmark, new_count: dCount, delta: (dCount - prevDenmark) - freshDenmark, url: 'https://platform.defenddenmark.dk/program/bug-bounty/' } });\n}\nif (prevAlerted) out.push({ json: { action: 'session_restored' } });\nout.push({ json: { action: 'update_state', singleton: 'state', denmark_count: dCount, iceland_count: iCount, session_alerted: false } });\nreturn out;"
      },
