      "id": "1872433f-27b3-4900-bd0d-b379084a3092",
      "name": "Get State",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        896,
        384
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const raw = $('Fetch Programs').first().json.data;\nlet resp = null;\ntry { resp = (typeof raw === 'string') ? JSON.parse(raw) : raw; } catch (e) { resp = null; }\nconst communities = resp && Array.isArray(resp.communities) ? resp.communities : null;\nconst stateRows = $('Get State').all();\nconst state = stateRows.length ? stateRows[0].json : {};\nconst prevAlerted = state.session_alerted === true || state.session_alerted === 'true';\nconst out = [];\nif (!communities) {\n  if (!prevAlerted) out.push({ json: { action: 'session_expired' } });\n  out.push({ json: { action: 'update_state', singleton: 'state', denmark_count: Number(state.denmark_count || 0), iceland_count: Number(state.iceland_count || 0), session_alerted: true } });\n  return out;\n}\nconst programs = [];\nfor (const c of communities) {\n  const country = c.community || 'Unknown';\n  const domain = c.communityDomain || 'defenddenmark.dk';\n  for (const cust of (c.customers || [])) {\n    const assets = Array.isArray(cust.assets) ? cust.assets : [];\n    const inScope = assets.filter(a => a && a.inScope).length;\n    programs.push({ id: cust.programId, name: cust.name || '(unnamed)', country, assetCount: assets.length, inScope, url: 'https://platform.' + domain + '/program/view/' + cust.programId });\n  }\n}\nconst known = new Set($('Get Known Programs').all().map(r => String(r.json.program_id)).filter(Boolean));\nconst fresh = programs.filter(p => p.id && !known.has(p.id));\nfor (const p of fresh) {\n  out.push({ json: { action: 'new_program', program_id: p.id, name: p.name, country: p.country, payout: p.inScope + ' in-scope / ' + p.assetCount + ' assets', url: p.url } });\n}\nconst dCount = (communities.find(c => c.community === 'Denmark') || { customers: [] }).customers.length;\nconst iCount = (communities.find(c => c.community === 'Iceland') || { customers: [] }).customers.length;\nif (prevAlerted) out.push({ json: { action: 'session_restored' } });\nout.push({ json: { action: 'update_state', singleton: 'state', denmark_count: dCount, iceland_count: iCount, session_alerted: false } });\nreturn out;"
      },
